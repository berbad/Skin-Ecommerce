NODE_ENV=production
PORT=5000
MONGODB_URI=
# Still named JWT_SECRET for compatibility; now signs CSRF tokens, not login JWTs.
# Generate a fresh random value with at least 32 characters in the secret manager.
JWT_SECRET=
# Canonical base64 encoding of exactly 32 random bytes. Back up securely.
MFA_ENCRYPTION_KEY=
# Exact trusted ingress IPs/subnets, comma separated. Never use true or a hop count.
TRUST_PROXY=
CLIENT_URL=https://eternalbotanic.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_RATE_ID=
SENDGRID_API_KEY=
EMAIL_USER=noreply@eternalbotanic.com
ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
