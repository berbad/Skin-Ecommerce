# Disabled until deployment review, correct provider prices, and restricted DB roles are configured.
CHAT_ENABLED=false
APP_ENV=production
OPENAI_API_KEY=
CHAT_MODEL=
CHAT_TOKEN_PARAMETER=max_completion_tokens
CHAT_ALLOWED_ORIGINS=https://www.eternalbotanic.com
CHAT_CATALOG_MONGODB_URI=
CHAT_CATALOG_DB=store
CHAT_QUOTA_MONGODB_URI=
CHAT_QUOTA_DB=chat_controls
CHAT_QUOTA_SECRET=
# All following fields are required positive integers when enabled.
CHAT_DAILY_REQUESTS=
CHAT_DAILY_TOKENS=
CHAT_DAILY_COST_MICROUSD=
CHAT_INPUT_MICROUSD_PER_TOKEN=
CHAT_OUTPUT_MICROUSD_PER_TOKEN=
# Default listener is local only. Never use wildcard proxy trust.
CHAT_BIND_HOST=127.0.0.1
CHAT_TRUSTED_PROXY_IPS=
PORT=8000
